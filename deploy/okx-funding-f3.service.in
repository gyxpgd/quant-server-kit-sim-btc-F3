# Generated by deploy/install-service.sh. Do not install this template directly.
[Unit]
Description=OKX Funding F3 public-data paper account
Wants=mihomo-proxy.service
After=mihomo-proxy.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
EnvironmentFile=-@ENVIRONMENT_FILE@
ExecStart=@PYTHON@ @PAPER_SCRIPT@ run --config @CONFIG@ --data-dir @DATA_DIR@
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
